APP_BASE_URL=/stagia
APP_TIMEZONE=Africa/Kinshasa

# Base MySQL locale : laissez DB_SSL_CA vide.
# Aiven : recopiez les valeurs depuis Service URI / Connection information.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stagia_recovery
DB_USER=root
DB_PASSWORD=
DB_SSL_CA=
DB_SSL_VERIFY_SERVER_CERT=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=STAGIA-RDC

# MaishaPay - secrets exclusivement fournis par l'environnement (jamais en base).
# 0 = sandbox, 1 = production.
MAISHAPAY_ENABLED=false
MAISHAPAY_GATEWAY_MODE=0
MAISHAPAY_C2B_URL=https://marchand.maishapay.online/api/payment/rest/vers1.0/merchant
MAISHAPAY_PUBLIC_API_KEY=
MAISHAPAY_SECRET_API_KEY=
# URL HTTPS publique recevant le webhook signe par MaishaPay.
MAISHAPAY_CALLBACK_URL=https://stagia-rdc.onrender.com/maishapay-callback.php
MAISHAPAY_TIMEOUT_SECONDS=30

# Lien profond ou lien universel ouvert par l'application mobile.
MOBILE_PASSWORD_RESET_URL=

# Minimum 24 caractères, utilisée pour chiffrer les secrets de communication.
COMMUNICATION_CONFIG_KEY=

# Facultatif : fournisseurs externes SMS et push.
SMS_WEBHOOK_URL=
PUSH_WEBHOOK_URL=

# Facultatif : emplacement personnalisé de la bibliothèque.
BIBLIOTHEQUE_STORAGE_DIR=
